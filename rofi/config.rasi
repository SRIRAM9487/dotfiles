configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "kitty";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: false;

    matching: "fuzzy";
    sort: true;

    lines: 8;
    width: 45;
    location: 0;
    anchor: center;

    font: "JetBrainsMono Nerd Font 12";
}
// @theme "theme"
